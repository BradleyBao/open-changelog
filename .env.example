# This ChangeLog API is an example, please change it to your own. 
DEFAULT_CHANGELOG_API_URL=https://api.tianyibrad.com/api/collections/OpenChangeLog/records
# Set this in production to protect /admin. Never prefix it with VITE_.
ADMIN_PASSWORD=change-me-before-deploying
# Docker bind address and host port. Use 127.0.0.1 behind host Nginx.
OPEN_CHANGELOG_HOST=0.0.0.0
OPEN_CHANGELOG_PORT=8080
OPEN_CHANGELOG_TAG=latest
