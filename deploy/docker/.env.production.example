# Copy this file to .env next to this compose file, then fill in the values.

# This ChangeLog API is an example, please change it to your own.
DEFAULT_CHANGELOG_API_URL=https://api.tianyibrad.com/api/collections/OpenChangeLog/records
# Required. Protects /admin. Never prefix it with VITE_.
ADMIN_PASSWORD=change-me-before-deploying
# Docker bind address and host port. Use 127.0.0.1 behind a host Nginx/reverse proxy.
OPEN_CHANGELOG_HOST=0.0.0.0
OPEN_CHANGELOG_PORT=8080
# Image tag to pull. Use "latest" or pin to a commit SHA published by CI.
OPEN_CHANGELOG_TAG=latest
